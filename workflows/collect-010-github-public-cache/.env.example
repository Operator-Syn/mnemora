# Environment for the `collect-010-github-public-cache` workflow only.
#
# Loaded into the n8n and worker containers by compose's `env_file`, not by the
# root .env. The root .env configures the stack (images, ports, secrets); this
# file configures this workflow's behaviour.
#
# Naming: <CATEGORY>_<NNN>_<SETTING> — the numeric tag keeps these traceable to
# the directory name, and numbering restarts per category. Every workflow's
# variables share one container namespace, so two workflows must never define
# the same name.
#
# Copy to `.env` next to this file (gitignored) and adjust.

# Accounts whose PUBLIC repositories are collected — user or organisation,
# comma separated. Scope: every public repository each account owns. Nothing
# private is reachable: discovery uses the public repository listing, which
# never returns private repositories even with a token present.
COLLECT_010_OWNERS=Operator-Syn

# Commit window. 0 = the whole history of every repository, from the first commit to
# the most recent. Any positive value keeps a rolling window of that many days, which
# is the cheaper option and all a "recent activity" dashboard needs.
#
# Full history measured on this account: 6,993 commits over 24 public repositories,
# roughly 95 API calls and 1-2 minutes per run.
COLLECT_010_WINDOW_DAYS=0

# Runaway guard: maximum commit pages (100 commits each) fetched per repository PER RUN.
# Spending it marks the record `partial` and stores a cursor, so the next run continues from the
# following page instead of re-reading this run's pages forever. A history larger than the budget
# therefore finishes over several runs; it no longer fails to finish at all.
COLLECT_010_MAX_COMMIT_PAGES=50

# Ignore the cached copy and re-fetch everything. Normally the run compares against
# the cache and only fetches what changed; set this to true to rebuild from scratch,
# for example after changing COLLECT_010_WINDOW_DAYS or if the cache is suspect.
COLLECT_010_FORCE_FULL_RESYNC=false

# Stop collecting when this many API calls remain, so a run cannot die part-way through
# with every remaining repository erroring. Repositories not reached keep their cached
# data and are reported as `deferred`.
COLLECT_010_RATE_RESERVE=25

# One run at a time. Before any GitHub call the run claims a lease in the product database;
# a second run started while one is in flight fails immediately, naming the holder, instead of
# duplicating a 24-repository crawl. The lease is released when fetching finishes, and expires
# on its own if a run dies, so a crash costs at most RUN_LOCK_TTL_SECONDS of blocked runs.
COLLECT_010_RUN_LOCK=true

# Cold start: how many never-collected repositories one run may fetch. A first run against an
# empty database would otherwise fetch every repository in one burst — ~95 calls and four
# minutes here, and any interruption would leave no record of what is still outstanding.
# Repositories beyond the cap are written to the database as source_state='pending', so the
# dashboard can tell 'not collected yet' from 'empty', and the next run continues.
# 0 disables the cap.
COLLECT_010_MAX_NEW_PER_RUN=12
# Must exceed a cold run (measured 252 s) and stay under the 6-hour schedule.
COLLECT_010_RUN_LOCK_TTL_SECONDS=900

# Forks and archived repositories are published too by default, so the cache
# matches "all public repositories". Set to false to narrow the set.
COLLECT_010_INCLUDE_FORKS=true
COLLECT_010_INCLUDE_ARCHIVED=true

# Optional. Unauthenticated GitHub allows 60 requests/hour; a token raises that
# to 5,000/hour. Each run costs 1 listing call + 2 per repository, so a token is
# effectively required once the account has more than a handful of repos.
# Leave empty to collect anonymously — the workflow omits the Authorization
# header entirely rather than sending a blank one.
#
# Issue a token with the NARROWEST possible access: a classic token with no
# scopes, or a fine-grained one limited to public repositories, read-only.
COLLECT_010_GITHUB_TOKEN=
