  "nodes": [
    {
      "id": "c1a0f0a0-0001-4000-8000-000000000001",
      "name": "GET repos",
      "notes": "The index. `?include_archived=true` adds archived repositories; they are hidden by default because a portfolio is a claim about current work.\n\nAll four routes require the `X-Mnemora-Read-Key` header (credential `Mnemora Read`). The only legitimate caller is the site's SSR runtime, so the key lives in the server's secret store and never reaches a browser \u2014 that is what makes it a secret rather than decoration.",
      "notesInFlow": true,
      "parameters": {
        "httpMethod": "GET",
        "path": "api/repos",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        },
        "authentication": "headerAuth"
      },
      "position": [
        -260,
        -260
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "serve010-api-repos",
      "credentials": {
        "httpHeaderAuth": {
          "id": "5vRYCAvEU9cbfMUZ",
          "name": "Mnemora Read"
        }
      }
    },
    {
      "id": "c1a0f0a0-0002-4000-8000-000000000002",
      "name": "GET repository",
      "notes": "One repository. The key is `?id=` and accepts the numeric repository_id or `owner/name` \u2014 a dashboard links by name, a script by id.\n\nNot `/api/repos/:id`: n8n advertises path parameters, but its lookup keys dynamic webhooks on the request's FIRST segment being the webhook id, so `/api/repos/123` registers and then never matches. Verified live; query strings it is.\n\nRequires the `X-Mnemora-Read-Key` header (credential `Mnemora Read`); n8n answers 403 before the workflow runs if it is missing or wrong.",
      "notesInFlow": true,
      "parameters": {
        "httpMethod": "GET",
        "path": "api/repository",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        },
        "authentication": "headerAuth"
      },
      "position": [
        -260,
        -60
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "serve010-api-repository",
      "credentials": {
        "httpHeaderAuth": {
          "id": "5vRYCAvEU9cbfMUZ",
          "name": "Mnemora Read"
        }
      }
    },
    {
      "id": "c1a0f0a0-0003-4000-8000-000000000003",
      "name": "GET commits",
      "notes": "Commits newest first, either across every repository or scoped with `?repository_id=owner/name` (or a numeric id). `?limit=` 1..200, default 50; `?before=` is the cursor from the previous page's next_before.\n\nOne route for both feeds because they differ by a single predicate.\n\nRequires the `X-Mnemora-Read-Key` header (credential `Mnemora Read`); n8n answers 403 before the workflow runs if it is missing or wrong.",
      "notesInFlow": true,
      "parameters": {
        "httpMethod": "GET",
