{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "javascript": {
    "globals": [
      "$input",
      "$json",
      "$node",
      "$workflow",
      "$env",
      "$execution",
      "$now",
      "$",
      "$parameter",
      "$items",
      "$vars",
      "$secrets",
      "$getWorkflowStaticData"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "files": {
    "includes": [
      "**",
      "!frontend/worker-configuration.d.ts",
      "!frontend/src/routeTree.gen.ts",
      "!!frontend/dist",
      "!!frontend/.wrangler",
      "!!frontend/.tanstack",
      "!!frontend/node_modules",
      "!!frontend/.intent",
      "!!frontend/.agents",
      "!!.agents/skills/impeccable",
      "!!.claude/skills/impeccable"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
