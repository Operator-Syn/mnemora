# Copy to .env in this directory on the VPS and set real values. `docker compose`
# reads it automatically; keep it private (chmod 600). Never commit it.
# n8n supports PostgreSQL 17 and 18; 16 is compatibility-only. Pinned to the
# newest supported major; `docker compose pull` picks up patches within 18.
POSTGRES_VERSION=18
REDIS_VERSION=7-alpine
# Pinned, not floating. `latest` re-resolves on every `compose pull`, so an
# unattended pull could land a release nobody reviewed; n8n also migrates its
# database on boot, which is not something to discover afterwards.
# To update deliberately: set the new tag here, `docker compose pull`, `up -d`.
# To roll back: set the previous tag and pull again.
# `next` currently tracks 2.45.0 and is a release candidate — do not use it here.
N8N_VERSION=2.44.4

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_KEY

# Product database — separate from n8n's, so the persist workflow's credentials cannot
# read or write n8n's own state, and product data has its own backup boundary.
# Create once per host:
#   CREATE ROLE mnemora_app LOGIN PASSWORD '<secret>';
#   CREATE DATABASE mnemora OWNER mnemora_app;
#   REVOKE CONNECT ON DATABASE n8n FROM PUBLIC;
# then apply migrations with ./scripts/migrate.sh (see db/migrations/0001_init.sql).
MNEMORA_DB_NAME=mnemora
MNEMORA_DB_USER=mnemora_app
MNEMORA_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET

# Bound to loopback; the host's independently managed reverse proxy can reach this.
N8N_HOST_PORT=5680
# URL clients use to reach this instance. Must include the host port, not 5678,
# or webhook and OAuth metadata advertise an address nobody listens on.
N8N_PUBLIC_URL=http://127.0.0.1:5680
GENERIC_TIMEZONE=UTC
# Hours to keep execution records (7 days). Successful executions store no node data;
# failures keep theirs for debugging. Without pruning, a multi-megabyte collector run
# grows the database on every schedule tick.
EXECUTIONS_MAX_AGE_HOURS=168
# Passed to the worker as `--concurrency`; n8n 2.x ignores a same-named env var.
QUEUE_WORKER_CONCURRENCY=5
