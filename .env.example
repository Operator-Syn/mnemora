# Copy to .env in this directory on the VPS and set real values. `docker compose`
# reads it automatically; keep it private (chmod 600). Never commit it.
# n8n supports PostgreSQL 17 and 18; 16 is compatibility-only. Pinned to the
# newest supported major; `docker compose pull` picks up patches within 18.
POSTGRES_VERSION=18
REDIS_VERSION=7-alpine
# Pinned, not floating. `latest` re-resolves on every `compose pull`, so an
# unattended pull could land a release nobody reviewed; n8n also migrates its
# database on boot, which is not something to discover afterwards.
# To update deliberately: set the new tag here, `docker compose pull`, `up -d`.
# To roll back: set the previous tag and pull again.
# `next` currently tracks 2.45.0 and is a release candidate — do not use it here.
N8N_VERSION=2.44.5

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_KEY

# Product database — separate from n8n's, so the persist workflow's credentials cannot
# read or write n8n's own state, and product data has its own backup boundary.
# Create once per host:
#   CREATE ROLE mnemora_app LOGIN PASSWORD '<secret>';
#   CREATE DATABASE mnemora OWNER mnemora_app;
#   REVOKE CONNECT ON DATABASE n8n FROM PUBLIC;
# then apply migrations with ./scripts/migrate.sh (see db/migrations/0001_init.sql).
MNEMORA_DB_NAME=mnemora
MNEMORA_DB_USER=mnemora_app
MNEMORA_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
# Read-only role used by the collector to decide what it already has. It cannot write:
#   CREATE ROLE mnemora_reader LOGIN PASSWORD '<secret>';
#   GRANT CONNECT ON DATABASE mnemora TO mnemora_reader;
#   (in the mnemora database) GRANT USAGE ON SCHEMA public TO mnemora_reader;
#   (in the mnemora database) GRANT SELECT ON mnemora_repositories, mnemora_commits,
#     mnemora_schema_migrations TO mnemora_reader;
MNEMORA_READER_USER=mnemora_reader
MNEMORA_READER_PASSWORD=REPLACE_WITH_RANDOM_SECRET
# Header token for the telemetry read endpoint (workflows/debug-010-telemetry).
# Store the value as an n8n httpHeaderAuth credential named 'Mnemora Telemetry', header
# X-Mnemora-Token. Without it the endpoint answers 403 before running any query.
MNEMORA_TELEMETRY_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# Header token for the write pipe (persist-010). Store the value as an n8n httpHeaderAuth
# credential named 'Mnemora Pipe', header X-Mnemora-Pipe-Token. HTTP nodes authenticate with
# that credential; the three Code nodes that call the webhook directly read this variable,
# because a Code node cannot hold a credential. Without the header the pipe answers 403.
MNEMORA_PIPE_TOKEN=REPLACE_WITH_RANDOM_TOKEN

# --- n8n 3.0 readiness -------------------------------------------------------------------
# Values the 3.0 migration report calls out. Each is pinned explicitly so an upgrade cannot
# change behaviour underneath a running workflow.
#
# Code-node task timeout. 3.0 lowers the default from 300s to 60s; the collector's Collect node
# runs a whole history fetch inside one Code task (68-116s cold, 252s before the per-run cap), so
# 60s would abort it mid-crawl. Must exceed the longest measured run.
N8N_RUNNERS_TASK_TIMEOUT=600
# 3.0 removes this variable and always routes manual executions to workers in queue mode.
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
# No community packages are installed; 3.0 disables unverified ones by default.
N8N_UNVERIFIED_PACKAGES_ENABLED=false
# No Compression node is used by any workflow. Pinned to the 3.0 ceilings (256 MiB, 1000 entries)
# so nothing can depend on the old, larger limits.
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=268435456
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=1000

# Bound to loopback; the host's independently managed reverse proxy can reach this.
N8N_HOST_PORT=5680
# URL clients use to reach this instance. Must include the host port, not 5678,
# or webhook and OAuth metadata advertise an address nobody listens on.
N8N_PUBLIC_URL=http://127.0.0.1:5680
GENERIC_TIMEZONE=UTC
# Hours to keep execution records (7 days). Successful executions store no node data;
# failures keep theirs for debugging. Without pruning, a multi-megabyte collector run
# grows the database on every schedule tick.
EXECUTIONS_MAX_AGE_HOURS=168
# Passed to the worker as `--concurrency`; n8n 2.x ignores a same-named env var.
QUEUE_WORKER_CONCURRENCY=5
